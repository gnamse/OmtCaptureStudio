<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmtCaptureStudio.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- Semantic Color Palette -->
        <Color x:Key="StudioBgColor">#0F0F12</Color>
        <Color x:Key="StudioSurfaceColor">#18181B</Color>
        <Color x:Key="StudioSurfaceElevatedColor">#27272A</Color>
        <Color x:Key="StudioBorderColor">#27272A</Color>
        <Color x:Key="StudioBorderSubtleColor">#3F3F46</Color>

        <Color x:Key="StudioTextPrimaryColor">#F4F4F5</Color>
        <Color x:Key="StudioTextSecondaryColor">#A1A1AA</Color>
        <Color x:Key="StudioTextMutedColor">#80808A</Color>

        <Color x:Key="StudioAccentSuccessColor">#10B981</Color>
        <Color x:Key="StudioAccentDangerColor">#DC2626</Color>
        <Color x:Key="StudioAccentPrimaryColor">#4F46E5</Color>

        <!-- Semantic SolidColorBrushes -->
        <SolidColorBrush x:Key="StudioBg" Color="#0F0F12"/>
        <SolidColorBrush x:Key="StudioSurface" Color="#18181B"/>
        <SolidColorBrush x:Key="StudioSurfaceElevated" Color="#27272A"/>
        <SolidColorBrush x:Key="StudioBorder" Color="#27272A"/>
        <SolidColorBrush x:Key="StudioBorderSubtle" Color="#3F3F46"/>

        <SolidColorBrush x:Key="StudioTextPrimary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="StudioTextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="StudioTextMuted" Color="#80808A"/>
        <SolidColorBrush x:Key="StudioTextOnAccent" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="StudioAccentSuccess" Color="#10B981"/>
        <SolidColorBrush x:Key="StudioAccentDanger" Color="#DC2626"/>
        <SolidColorBrush x:Key="StudioAccentPrimary" Color="#4F46E5"/>

        <!-- Spacing Scale (4px base) -->
        <Thickness x:Key="SpaceXs">4</Thickness>
        <Thickness x:Key="SpaceSm">8</Thickness>
        <Thickness x:Key="SpaceMd">12</Thickness>
        <Thickness x:Key="SpaceLg">16</Thickness>
        <Thickness x:Key="SpaceXl">24</Thickness>
        <Thickness x:Key="Space2xl">32</Thickness>

        <!-- Bar Padding -->
        <Thickness x:Key="BarPadding">16,8</Thickness>
        <Thickness x:Key="StatusBarPadding">16,0</Thickness>

        <!-- Standard Radius -->
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">8</CornerRadius>
        <CornerRadius x:Key="RadiusLg">12</CornerRadius>

        <!-- Viewport HUD & Modal Scrims -->
        <SolidColorBrush x:Key="StudioHudScrim" Color="#CC18181B"/>
        <SolidColorBrush x:Key="StudioModalScrim" Color="#CC09090B"/>

        <!-- Modal elevation. BoxShadows is a value type, so this token IS the value
             (declared once, not the Color + SolidColorBrush pair - see DESIGN.md §2). -->
        <BoxShadows x:Key="StudioShadowModal">0 12 32 0 #CC09090B</BoxShadows>

        <!-- Calibrated Broadcast VU Meter Gradient (-60 dBFS to 0 dBFS) -->
        <LinearGradientBrush x:Key="StudioVuMeterGradient" StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Color="#10B981" Offset="0.0"/>
            <GradientStop Color="#22C55E" Offset="0.65"/>
            <GradientStop Color="#84CC16" Offset="0.70"/>
            <GradientStop Color="#EAB308" Offset="0.73"/>
            <GradientStop Color="#F59E0B" Offset="0.88"/>
            <GradientStop Color="#EF4444" Offset="0.90"/>
            <GradientStop Color="#DC2626" Offset="1.00"/>
        </LinearGradientBrush>

        <!-- Drawn Icon Set (24x24 stroke geometry, consistent 2px weight) -->
        <StreamGeometry x:Key="IconRefresh">M4.35 6.4A8 8 0 1 1 4 14 M4 3v4h4</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconWarning">M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01</StreamGeometry>
        <!-- NET-012: drawn disclosure chevrons (DESIGN §6 - StreamGeometry only, no glyphs/emoji). -->
        <StreamGeometry x:Key="IconChevronDown">M5 8 L12 15 L19 8</StreamGeometry>
        <StreamGeometry x:Key="IconChevronUp">M5 15 L12 8 L19 15</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
