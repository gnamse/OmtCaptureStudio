<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmtCaptureStudio.Controls.VuMeterControl"
             Background="{DynamicResource StudioSurface}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Clip Indicators -->
            <RowDefinition Height="*"/>    <!-- Calibrated Meter Area (Scale + Tracks) -->
            <RowDefinition Height="Auto"/> <!-- Channel Labels (L, R) -->
            <RowDefinition Height="Auto"/> <!-- Readout & Monitor Button -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Margin="0,0,0,8" Background="{DynamicResource StudioSurfaceElevated}" CornerRadius="4" Padding="4,3">
            <TextBlock Text="AUDIO LEVELS" Foreground="{DynamicResource StudioTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- 2. Clip Indicators -->
        <Grid Grid.Row="1" Margin="32,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ClipLeft" Grid.Column="0" Background="{DynamicResource StudioBorderSubtle}" CornerRadius="2" Height="14">
                <TextBlock Text="CLIP" Foreground="{DynamicResource StudioTextPrimary}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="ClipRight" Grid.Column="2" Background="{DynamicResource StudioBorderSubtle}" CornerRadius="2" Height="14">
                <TextBlock Text="CLIP" Foreground="{DynamicResource StudioTextPrimary}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 3. Calibrated Meter Area -->
        <Grid Grid.Row="2" x:Name="MeterAreaGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/> <!-- Dynamic dB Scale & Tick Marks -->
                <ColumnDefinition Width="*"/>  <!-- Left Channel Bar -->
                <ColumnDefinition Width="4"/>  <!-- Gap -->
                <ColumnDefinition Width="*"/>  <!-- Right Channel Bar -->
            </Grid.ColumnDefinitions>

            <!-- Dynamic dB Scale Canvas -->
            <Canvas Grid.Column="0" x:Name="ScaleCanvas" ClipToBounds="True"/>

            <!-- Left Channel Track -->
            <Border Grid.Column="1" Background="{DynamicResource StudioBg}" CornerRadius="3" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="TrackLeft" Background="{DynamicResource StudioBg}">
                    <!-- Clipper reveals full-height gradient from bottom -->
                    <Border x:Name="BarClipperLeft" VerticalAlignment="Bottom" Height="0" ClipToBounds="True">
                        <Rectangle x:Name="GradientBarLeft" VerticalAlignment="Bottom" Height="300">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                    <GradientStop Color="#22C55E" Offset="0.65"/>
                                    <GradientStop Color="#84CC16" Offset="0.70"/>
                                    <GradientStop Color="#EAB308" Offset="0.73"/>
                                    <GradientStop Color="#F59E0B" Offset="0.88"/>
                                    <GradientStop Color="#EF4444" Offset="0.90"/>
                                    <GradientStop Color="#DC2626" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Border>
                    <Rectangle x:Name="PeakLineLeft" Height="2" Fill="#FFFFFF" VerticalAlignment="Bottom" Margin="0" Opacity="0.95"/>
                </Grid>
            </Border>

            <!-- Right Channel Track -->
            <Border Grid.Column="3" Background="{DynamicResource StudioBg}" CornerRadius="3" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="TrackRight" Background="{DynamicResource StudioBg}">
                    <Border x:Name="BarClipperRight" VerticalAlignment="Bottom" Height="0" ClipToBounds="True">
                        <Rectangle x:Name="GradientBarRight" VerticalAlignment="Bottom" Height="300">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                    <GradientStop Color="#22C55E" Offset="0.65"/>
                                    <GradientStop Color="#84CC16" Offset="0.70"/>
                                    <GradientStop Color="#EAB308" Offset="0.73"/>
                                    <GradientStop Color="#F59E0B" Offset="0.88"/>
                                    <GradientStop Color="#EF4444" Offset="0.90"/>
                                    <GradientStop Color="#DC2626" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Border>
                    <Rectangle x:Name="PeakLineRight" Height="2" Fill="#FFFFFF" VerticalAlignment="Bottom" Margin="0" Opacity="0.95"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Channel Labels -->
        <Grid Grid.Row="3" Margin="32,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="L" Foreground="{DynamicResource StudioTextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="R" Foreground="{DynamicResource StudioTextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- 5. Numerical Readout & Monitor Button -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="TxtDbReadout" Text="-inf dB" Foreground="{DynamicResource StudioTextPrimary}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
            <ToggleButton x:Name="BtnMonitor" Content="Monitor" Height="28" Margin="0,8,0,0"
                          Background="{DynamicResource StudioSurfaceElevated}" Foreground="{DynamicResource StudioTextPrimary}" FontSize="10" FontWeight="SemiBold"
                          BorderBrush="{DynamicResource StudioBorderSubtle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          AutomationProperties.Name="Audio Monitor Toggle"
                          ToolTip.Tip="Toggle real-time local audio monitoring playback through speakers or headphones"/>
        </StackPanel>
    </Grid>
</UserControl>
