<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OmtCaptureStudio.Controls"
        xmlns:models="clr-namespace:OmtCaptureStudio.Models"
        xmlns:views="clr-namespace:OmtCaptureStudio.Views"
        xmlns:vm="clr-namespace:OmtCaptureStudio.ViewModels"
        mc:Ignorable="d"
        x:Class="OmtCaptureStudio.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OMT Capture Studio - Open Media Transport Recorder"
        Height="800" Width="1240" MinHeight="650" MinWidth="950"
        Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioTextPrimary}"
        Icon="avares://OmtCaptureStudio/Resources/app.ico"
        WindowStartupLocation="CenterScreen">

    <!-- ADR-0011: ONE window, ONE swapped content region.
         Row 0 is the content region (the mode views are layered and mutually exclusive by state);
         Row 1 is the shared chrome that appears in every state — status bar, telemetry, recording
         health, diagnostics button. The modal overlay spans both. -->
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0">
            <views:ModeSelectionView x:Name="PickerView" IsVisible="{CompiledBinding IsPickerVisible}"/>
            <views:CaptureModeView   x:Name="CaptureView" IsVisible="{CompiledBinding IsCaptureModeVisible}"/>
            <views:BroadcastModeView x:Name="BroadcastView" IsVisible="{CompiledBinding IsBroadcastModeVisible}"/>
        </Grid>

        <!-- Shared chrome: status / telemetry / recording health / diagnostics -->
        <!-- 4. BOTTOM STATUS / TELEMETRY BAR (shared chrome: Row 1, outside the content region) -->
        <Border Grid.Row="1" Background="{DynamicResource StudioBg}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,1,0,0" Padding="{DynamicResource StatusBarPadding}" Height="32">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock x:Name="TxtStatus" Text="{CompiledBinding StatusText}" Foreground="{DynamicResource StudioTextSecondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Assertive"/>

                <!-- Telemetry Readouts -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAudioTelemetry" Text="{CompiledBinding AudioTelemetryText}" Foreground="{DynamicResource StudioTextSecondary}" FontSize="11" Margin="12,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="·" Foreground="{DynamicResource StudioBorderSubtle}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBitrate" Text="{CompiledBinding BitrateText}" Foreground="{DynamicResource StudioTextSecondary}" FontSize="11" Margin="12,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="·" Foreground="{DynamicResource StudioBorderSubtle}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDroppedFrames" Text="{CompiledBinding DroppedFramesText}" Foreground="{DynamicResource StudioTextSecondary}" FontSize="11" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="·" Foreground="{DynamicResource StudioBorderSubtle}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <!-- Recording Health (FEAT-07). RECORDING-path drops and A/V drift — distinct from the
                         receiver-side "Dropped" counter above. Readouts are projections of
                         CaptureSession.GetRecordingHealthSnapshot(); warning colours come from the VM. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{CompiledBinding IsRecordingHealthVisible}">
                        <TextBlock Text="REC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StudioTextMuted}" VerticalAlignment="Center" Margin="12,0,5,0"
                                   ToolTip.Tip="Recording-path health (encoder, achieved bitrate, recording drops, A/V drift)"/>
                        <TextBlock x:Name="TxtHealthFfmpeg" Text="{CompiledBinding RecordingHealthFfmpegText}" FontSize="10" Foreground="{DynamicResource StudioTextSecondary}" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" AutomationProperties.Name="FFmpeg Version" ToolTip.Tip="ffmpeg build resolved at startup - the encoder provenance a bug report needs"/>
                        <TextBlock x:Name="TxtHealthEncoder" Text="{CompiledBinding RecordingHealthEncoderText}" FontSize="10" Foreground="{DynamicResource StudioTextSecondary}" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="Encoder actually used for this take (AutoHardware resolved)"/>
                        <TextBlock Text="·" Foreground="{DynamicResource StudioBorderSubtle}" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHealthBitrate" Text="{CompiledBinding RecordingHealthBitrateText}" FontSize="10" Foreground="{DynamicResource StudioTextSecondary}" VerticalAlignment="Center"
                                   ToolTip.Tip="Achieved output bitrate (file size / media duration)"/>
                        <TextBlock Text="·" Foreground="{DynamicResource StudioBorderSubtle}" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHealthDrops" Text="{CompiledBinding RecordingHealthDropsText}" FontSize="10" FontWeight="SemiBold" Foreground="{CompiledBinding RecordingDropsForeground}" VerticalAlignment="Center"
                                   ToolTip.Tip="Recording-path frames/chunks dropped (warning above threshold)"/>
                        <TextBlock Text="·" Foreground="{DynamicResource StudioBorderSubtle}" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHealthDrift" Text="{CompiledBinding RecordingHealthDriftText}" FontSize="10" FontWeight="SemiBold" Foreground="{CompiledBinding RecordingDriftForeground}" VerticalAlignment="Center"
                                   ToolTip.Tip="Live A/V resample ratio; warns when pinned at the 0.9/1.1 clamp"/>
                        <Button x:Name="BtnDiagnostics" Content="Diagnostics" FontSize="10" MinHeight="22" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                AutomationProperties.Name="Toggle FFmpeg diagnostics drawer"
                                ToolTip.Tip="Show the FFmpeg diagnostic output and the last stop verdict"
                                Command="{CompiledBinding ToggleDiagnosticsDrawerCommand}"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtVersion" Text="{CompiledBinding VersionText}" Foreground="{DynamicResource StudioTextMuted}" FontSize="11" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- 5. MODAL OVERLAY: Active Recording Close Protection -->
        <Border x:Name="RecordingCloseOverlay" Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource StudioModalScrim}" IsVisible="{CompiledBinding IsRecordingCloseOverlayVisible}" ZIndex="1000"
                AutomationProperties.Name="Recording in progress — confirmation required"
                AutomationProperties.HelpText="An active recording session is writing to disk. Stop and exit, or keep recording.">
            <Border Background="{DynamicResource StudioSurface}" BorderThickness="0"
                    CornerRadius="{DynamicResource RadiusLg}" Padding="24"
                    MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="{DynamicResource StudioShadowModal}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="{DynamicResource StudioAccentDanger}" Width="36" Height="36" CornerRadius="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconWarning}" Stroke="{DynamicResource StudioTextOnAccent}" StrokeThickness="2" Stretch="Uniform" Width="20" Height="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recording in Progress" Foreground="{DynamicResource StudioTextPrimary}"
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="An active recording session is currently writing to disk."
                                       Foreground="{DynamicResource StudioTextSecondary}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Closing the application now without stopping will truncate or corrupt the recorded media file. Would you like to stop recording safely and exit, or keep recording?"
                               Foreground="{DynamicResource StudioTextSecondary}" FontSize="13" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,12,*">
                        <Button x:Name="BtnKeepRecording" Grid.Column="0" Content="Keep Recording"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="12,8" Background="{DynamicResource StudioSurfaceElevated}"
                                Foreground="{DynamicResource StudioTextPrimary}" FontWeight="SemiBold"
                                AutomationProperties.Name="Keep Recording and Cancel Exit"
                                ToolTip.Tip="Cancel exit and continue recording"
                                IsEnabled="{CompiledBinding IsKeepRecordingEnabled}"
                                Command="{CompiledBinding KeepRecordingCommand}"/>
                        <Button x:Name="BtnStopAndExit" Grid.Column="2"
                                Content="{CompiledBinding StopAndExitButtonText}"
                                IsEnabled="{CompiledBinding IsStopAndExitEnabled}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="12,8" Background="{DynamicResource StudioAccentDanger}"
                                Foreground="{DynamicResource StudioTextOnAccent}" FontWeight="Bold"
                                AutomationProperties.Name="Stop Recording and Exit"
                                ToolTip.Tip="Stop recording to finalize file and exit application"
                                Command="{CompiledBinding StopAndExitCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
